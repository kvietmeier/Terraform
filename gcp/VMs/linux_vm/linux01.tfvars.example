###===================================================================================###
#
#  File:         linux01.tfvars.example
#  Created By:   Karl Vietmeier
#
#  Stubbed for GitHub – copy to linux01.tfvars (gitignored) and fill in.
#  Standard single Linux client VM for lab/testing.
#
###===================================================================================###

###===================================================================================###
#                            Project and Location Information
###===================================================================================###

project_id  = "gcp-project-id"
region      = "us-central1"
zone        = "us-central1-a"

###===================================================================================###
#                             Network Configuration
###===================================================================================###

vpc_name     = "default"
subnet_name  = "REPLACE_ME_SUBNET_NAME"

###===================================================================================###
#                              Service Account Configuration
###===================================================================================###

sa_email  = "sa@gcp-project-id.iam.gserviceaccount.com"
sa_scopes = ["cloud-platform"]

###===================================================================================###
#                                 VM Configuration
###===================================================================================###

vm_name       = "lab-client01"
machine_type  = "e2-medium"
os_image      = "rocky-linux-9-v20260910"
bootdisk_size = "100"
vm_tags       = ["lab-client", "lab-linux"]

###===================================================================================###
#                            SSH and Cloud-Init Configuration
###===================================================================================###

ssh_user             = "labuser"
ssh_key_file         = "../../../secrets/ssh_keys.txt"
cloudinit_configfile = "../../../scripts/cloud-init/cloud-init-universal.yaml"
