###===================================================================================###
#
#  File:  multi_map.terraform.tfvars.example
#  Copy to multi_map.terraform.tfvars or multi_map.auto.tfvars (gitignored).
#
###===================================================================================###

project_id = "gcp-project-id"
region     = "us-central1"
zone       = "us-central1-a"

vpc_name    = "default"
subnet_name = "default"

ssh_user             = "strata"
ssh_key_file         = "../../../secrets/ssh_keys.txt"
cloudinit_configfile = "../../../scripts/cloud-init/cloud-init-universal.yaml"

vm_name_prefix = "kv-"

# Keys = short names → instance name kv-copper, …
# ip_octet = host number in the subnet CIDR
vms = {
  copper = {
    machine_type  = "e2-standard-4"
    bootdisk_size = "100"
    os_image      = "ubuntu-os-cloud/ubuntu-2404-lts-amd64"
    ip_octet      = "21"
  }
  lead = {
    machine_type  = "e2-standard-4"
    bootdisk_size = "100"
    os_image      = "ubuntu-os-cloud/ubuntu-2404-lts-amd64"
    ip_octet      = "22"
  }
  zinc = {
    machine_type  = "e2-standard-4"
    bootdisk_size = "100"
    os_image      = "ubuntu-os-cloud/ubuntu-2404-lts-amd64"
    ip_octet      = "23"
  }
  moly = {
    machine_type  = "e2-standard-8"
    bootdisk_size = "200"
    os_image      = "ubuntu-os-cloud/ubuntu-2404-lts-amd64"
    ip_octet      = "24"
  }
  silver = {
    machine_type  = "e2-standard-4"
    bootdisk_size = "100"
    os_image      = "ubuntu-os-cloud/ubuntu-2404-lts-amd64"
    ip_octet      = "25"
  }
  gold = {
    machine_type  = "e2-standard-4"
    bootdisk_size = "100"
    os_image      = "ubuntu-os-cloud/ubuntu-2404-lts-amd64"
    ip_octet      = "26"
  }
}

service_account = {
  email  = "sa@gcp-project-id.iam.gserviceaccount.com"
  scopes = ["cloud-platform"]
}
