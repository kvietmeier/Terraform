###===================================================================================###
#
#  File:  multi.terraform.tfvars.example
#  Prefer multi.auto.tfvars.example for the mineral-name demo defaults.
#
###===================================================================================###

project_id = "gcp-project-id"
region     = "us-central1"
zone       = "us-central1-a"

vpc_name    = "default"
subnet_name = "default"

vm_name_prefix = "kv-"
vm_names       = ["copper", "lead", "zinc", "moly", "silver", "gold"]

ssh_user      = "strata"
machine_type  = "e2-standard-4"
os_image      = "ubuntu-os-cloud/ubuntu-2404-lts-amd64"
bootdisk_size = "100"

ssh_key_file         = "../../../secrets/ssh_keys.txt"
cloudinit_configfile = "../../../scripts/cloud-init/cloud-init-universal.yaml"

service_account = {
  email  = "sa@gcp-project-id.iam.gserviceaccount.com"
  scopes = ["cloud-platform"]
}
