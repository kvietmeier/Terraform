# Copy to terraform.tfvars (or private.auto.tfvars) and edit.
# Secrets (VPN shared_key, SSH key paths) stay out of git.
#
# Source inventory: gcp/CoreInfra (unchanged). Full subnet list matches vpcs/core.

project_id = "clouddev-itdesk124"
region     = "us-west2"
zone       = "us-west2-a"

vpc_name = "karlv-corevpc"

###--- Feature flags
enable_firewalls           = true
enable_dns_private         = true
enable_dns_ad_forwarder    = true
enable_dns_vast_forwarders = true
enable_vpn                 = false # set true + fill vpn {} below
enable_linux_vms           = false # needs ssh key + cloud-init paths
enable_windows_vms         = false # needs sysprep script path
enable_iap                 = false # set true + fill iap_user_emails

###--- Subnets (from CoreInfra/vpcs/core/private.auto.tfvars)
subnets = [
