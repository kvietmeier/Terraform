###===================================================================================###
#
#  File:  devops01.auto.tfvars.example
#  Copy to devops01.auto.tfvars (gitignored) — Terraform loads *.auto.tfvars automatically.
#
###===================================================================================###

project_id = "gcp-project-id"
region     = "us-central1"
zone       = "us-central1-a"

sa_email  = "PROJECT_NUMBER-compute@developer.gserviceaccount.com"
sa_scopes = ["cloud-platform"]

# Private-only NIC; cloud-assigned private IP (no public / static private IP vars needed)
vm_name       = "devops01"
machine_type  = "e2-medium"
os_image      = "rocky-linux-cloud/rocky-linux-9"
bootdisk_size = "200"
vm_tags       = ["lab-linux", "lab-infra"]
labels = {
  used     = "solutions"
  owned_by = "solutions"
}

ssh_user             = "labuser"
ssh_key_file         = "../../../../secrets/ssh_keys.txt"
cloudinit_configfile = "../../../../scripts/cloud-init/cloud-init-universal.yaml"

vpc_name    = "default"
subnet_name = "default"
