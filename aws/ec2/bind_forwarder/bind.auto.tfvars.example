###===================================================================================###
#
#  File:  bind.auto.tfvars.example
#  Created By: Karl Vietmeier
#
#  Copy to bind.auto.tfvars and edit. Day-2 changes are usually just:
#    vast_zones  +  vast_dns_ips
#
###===================================================================================###

region = "us-west-2"

vpc_id             = "vpc-xxxxxxxx"
subnet_id          = "subnet-xxxxxxxx"
security_group_ids = ["sg-xxxxxxxx"]
vpc_cidr           = "10.105.0.0/16"

ssh_key_name         = "karlv-aws_cloudkey"
ssh_user             = "ubuntu"
ssh_private_key_path = "$HOME/.ssh/admin_keys/karlv-aws_cloudkey.pem"

# Tiny is fine — BIND forwarder is nearly idle; cheap enough to leave up,
# and a good AutoShutdown candidate for after-hours lab.
instance_name = "bind-vast-fwd"
instance_type = "t3.micro"
bootdisk_size = 8

# Standard Solutions IT tags (vast-client is always merged in Terraform)
common_tags = {
  UsedBy       = "solutions"
  used_by      = "solutions"
  owned        = "solutions"
  longrun      = "yes"
  Project      = "VoC"
  Environment  = "lab"
  Lifecycle    = "demo"
  AutoShutdown = "true"
}

# --- The two knobs you usually change ---
vast_zones   = ["busab.org"]
vast_dns_ips = ["10.105.28.250"]

# AWS VPC resolver (use 169.254.169.254 on GCP)
cloud_resolver = "169.254.169.253"
