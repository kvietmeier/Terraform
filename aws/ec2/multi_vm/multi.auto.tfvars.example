###===================================================================================###
#
#  File:  multi.auto.tfvars.example
#  Copy to multi.auto.tfvars (gitignored) — Terraform loads *.auto.tfvars automatically.
#
###===================================================================================###

region = "us-west-2"

vpc_id             = "vpc-0123456789abcdef0"
subnet_id          = "subnet-0123456789abcdef0"
security_group_ids = ["sg-0123456789abcdef0"]

ssh_key_name         = "lab-keypair"
ssh_user             = "strata"
ssh_private_key_path = "$HOME/.ssh/lab-keypair.pem"
cloudinit_configfile = "../../../scripts/cloud-init/cloud-init-universal.yaml"

common_tags = {
  Project     = "poc"
  Environment = "lab"
  Lifecycle   = "demo"
  # Opt into after-hours stop (see ../autoshutdown/).
  AutoShutdown = "true"
}

os_amis = {
  ubuntu = {
    owners      = ["099720109477"] # Canonical
    name_filter = "ubuntu/images/hvm-ssd*/ubuntu-noble-24.04-amd64-server-*"
  }
  rocky = {
    owners      = ["792107900819"] # Rocky
    name_filter = "Rocky-9-EC2-Base-*.x86_64"
  }
}

# Mode B — named fleet (preferred for demos): kv-copper … kv-gold
vm_name_prefix = "kv-"
vm_names       = ["copper", "lead", "zinc", "moly", "silver", "gold"]

# Mode A — numbered fallback (leave vm_names = [] to use):
# vm_count     = 3
# vm_base_name = "linux"   # → kv-linux01, kv-linux02, kv-linux03

machine_type  = "m6i.2xlarge"
bootdisk_size = 256
os_type       = "ubuntu"
