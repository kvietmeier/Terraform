###===================================================================================###
#
#  File:  multi.auto.tfvars.example
#  Copy to multi.auto.tfvars (gitignored).
#
###===================================================================================###

resource_group_name = "rg-lab-clients"
location            = "westus3"

vm_name_prefix = "kv-"
# Mode B — named fleet (preferred for demos)
vm_names = ["copper", "lead", "zinc", "moly", "silver", "gold"]

# Mode A — numbered fallback (leave vm_names = [] to use):
# vm_count     = 3
# vm_base_name = "linux"

vm_size                = "Standard_E2bds_v5"
data_disk_count_per_vm = 1
ssh_user               = "strata"

disk_ctlr            = "NVMe"
os_disk_caching      = "ReadWrite"
os_disk_storage_type = "Premium_LRS"

image_publisher = "azure-hpc"
image_offer     = "azurelinux-hpc"
image_sku       = "3"
image_version   = "latest"

secure_boot_enabled = false
vtpm_enabled        = true

ssh_key_path         = "~/.ssh/id_rsa.pub"
cloudinit_configfile = "../../../scripts/cloud-init/cloud-init-universal.yaml"

existing_network_rg  = "rg-network"
existing_vnet_name   = "vnet-lab"
existing_subnet_name = "subnet-clients"
