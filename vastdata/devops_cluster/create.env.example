# Stage 1 create args for install_configure.py --create-env
# Copy to create.env (gitignored locally) and fill in real values.

VAST_CLUSTER_NAME=lab-cluster-01
VAST_CLOUD_PROVIDER=gcp
VAST_SUBNET=example-subnet-name

# GCP
VAST_GCP_PROTOCOL_VIPS=192.168.1.10-192.168.1.11
VAST_GCP_REGION=us-central1
VAST_GCP_ZONE=us-central1-a
# VAST_GCP_PROJECT_ID=
# VAST_GCP_SA_EMAIL=

# AWS (when VAST_CLOUD_PROVIDER=aws)
# VAST_AWS_SG_IDS=sg-xxxxxxxx
# VAST_AWS_REGION=us-west-2
# VAST_AWS_ZONE=us-west-2a
